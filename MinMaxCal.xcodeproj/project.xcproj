{
  "default-configuration": "Debug",
  "configurations": [
    "AppStore",
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": ".",
    },
  ],
  "files": [
    {
      "path": "PrivacyInfo.xcprivacy",
      "target-membership": [
        "MinMaxCal/resources",
        "MinMaxCal-iOS/resources",
        "MinMaxCal-watchOS/resources",
      ],
    }, {
      "kind": "folder",
      "path": "App",
      "opaque-folders": [ "Icons" ],
      "target-membership": [ "MinMaxCal" ],
      "membership-exceptions": [
        {
          "target": "MinMaxCal",
          "exclusions": [ "Icons", "Info.plist", "MinMaxCal.entitlements" ],
        },
      ],
    }, {
      "path": "App/Icons/AppIcon.icon",
      "target-membership": [
        "MinMaxCal/resources",
        "MinMaxCal-iOS/resources",
        "MinMaxCal-watchOS/resources",
      ],
    }, {
      "kind": "folder",
      "path": "iOSApp",
      "target-membership": [ "MinMaxCal-iOS" ],
      "membership-exceptions": [
        { "target": "MinMaxCal-iOS", "exclusions": [ "Info.plist" ] },
      ],
    }, {
      "kind": "group",
      "name": "Packages",
      "children": [
        { "path": "<PROJECT>/." },
      ],
    }, {
      "kind": "folder",
      "path": "watchOSApp",
      "target-membership": [ "MinMaxCal-watchOS" ],
      "membership-exceptions": [
        { "target": "MinMaxCal-watchOS", "exclusions": [ "Info.plist" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        {
          "kind": "group",
          "name": "iOS",
          "children": [
            { "path": "<PRODUCTS>/MinMaxCal.app", "id": "7BB036F1ADA565C2D232B9A8", "index": false },
          ],
        }, {
          "kind": "group",
          "name": "watchOS",
          "children": [
            { "path": "<PRODUCTS>/MinMaxCal.app", "id": "5A8BDA405502A4D70BC4E2D4", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "MinMaxCal-iOS/copy/Embed Watch Content", "header-preservation": "remove-on-copy" } ] },
          ],
        },
        { "path": "<PRODUCTS>/MinMaxCal.app", "id": "A8D863AA8C5DDD5B24C5A02E", "type": "wrapper.application", "index": false },
      ],
    }, {
      "kind": "group",
      "name": "Recovered References",
      "children": [
        { "path": "Version.xcconfig" },
      ],
    },
  ],
  "targets": [
    {
      "name": "MinMaxCal",
      "id": "A7BAF6DF074586AEAD9F971F",
      "product": "Products/MinMaxCal.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "AppStore", "file": "Recovered References/Version.xcconfig" },
        { "name": "Debug", "file": "Recovered References/Version.xcconfig" },
        { "name": "Release", "file": "Recovered References/Version.xcconfig" },
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "MinMaxCalAgenda",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MinMaxCalCoachingData",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MinMaxCalCoachingFeatures",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MinMaxCalData",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MinMaxCalDomain",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MinMaxCalFeatures",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MinMaxCalIntents",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "App/MinMaxCal.entitlements",
        "CODE_SIGN_IDENTITY[config=Debug]": "-",
        "CODE_SIGN_IDENTITY[config=Release]": "-",
        "CODE_SIGN_STYLE[config=AppStore]": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "INFOPLIST_FILE": "App/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.mikemcquaid.MinMaxCal",
        "SDKROOT": "macosx",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=AppStore]": "$(inherited) APP_STORE",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "MinMaxCal-iOS",
      "id": "3478A5B0FE59231C3093D7E3",
      "product": "Products/iOS/MinMaxCal.app",
      "product-type": "application",
      "legacy-provisioning-style": "automatic",
      "dependencies": [
        "MinMaxCal-watchOS",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
      ],
      "package-product-members": [
        {
          "product-name": "MinMaxCalAgenda",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MinMaxCalData",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MinMaxCalDomain",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "INFOPLIST_FILE": "iOSApp/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "0.1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.mikemcquaid.MinMaxCal",
        "PRODUCT_NAME": "MinMaxCal",
        "PROVISIONING_PROFILE_SPECIFIER[config=AppStore]": "$(IOS_PROFILE_UUID)",
        "SDKROOT": "iphoneos",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    }, {
      "name": "MinMaxCal-watchOS",
      "id": "6B21336B55392401F51F173A",
      "product": "Products/watchOS/MinMaxCal.app",
      "product-type": "application",
      "legacy-provisioning-style": "automatic",
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "MinMaxCalAgenda",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MinMaxCalData",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MinMaxCalDomain",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ARCHS": "$(ARCHS_STANDARD)",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "INFOPLIST_FILE": "watchOSApp/Info.plist",
        "MARKETING_VERSION": "0.1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.mikemcquaid.MinMaxCal.watchkitapp",
        "PRODUCT_NAME": "MinMaxCal",
        "PROVISIONING_PROFILE_SPECIFIER[config=AppStore]": "$(WATCHOS_PROFILE_UUID)",
        "SDKROOT": "watchos",
        "SKIP_INSTALL": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "4",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ARCHS": "arm64",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_GCD_PERFORMANCE": "YES",
    "CLANG_ANALYZER_LOCALIZABILITY_EMPTY_CONTEXT": "YES",
    "CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_ANALYZER_OSOBJECT_C_STYLE_CAST": "YES",
    "CLANG_ANALYZER_OTHER_CHECKERS": "optin.core optin.cplusplus optin.performance.Padding optin.portability optin.taint security",
    "CLANG_ANALYZER_OTHER_FLAGS": "$(inherited) -analyzer-werror",
    "CLANG_ANALYZER_SECURITY_BUFFER_OVERFLOW_EXPERIMENTAL": "YES",
    "CLANG_ANALYZER_SECURITY_FLOATLOOPCOUNTER": "YES",
    "CLANG_ANALYZER_SECURITY_INSECUREAPI_RAND": "YES",
    "CLANG_ANALYZER_SECURITY_INSECUREAPI_STRCPY": "YES",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++14",
    "CLANG_CXX_LIBRARY": "libc++",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_STATIC_ANALYZER_MODE": "deep",
    "CLANG_STATIC_ANALYZER_MODE_ON_ANALYZE_ACTION": "deep",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=AppStore]": "dwarf-with-dsym",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=AppStore]": "NO",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu11",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "$(inherited)",
      "DEBUG=1",
    ],
    "GCC_TREAT_WARNINGS_AS_ERRORS": "YES",
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_INHIBIT_ALL_WARNINGS": "NO",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
    "LD_WARN_DUPLICATE_LIBRARIES": "YES",
    "LD_WARN_UNUSED_DYLIBS": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "26.0",
    "MTL_ENABLE_DEBUG_INFO[config=AppStore]": "NO",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "MTL_TREAT_WARNINGS_AS_ERRORS": "YES",
    "ONLY_ACTIVE_ARCH": "YES",
    "OTHER_LDFLAGS": [
      "$(inherited)",
      "-Wl,-fatal_warnings",
    ],
    "OTHER_SWIFT_FLAGS": "$(inherited) -warn-implicit-overrides -Xfrontend -warn-soft-deprecated",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "RUN_CLANG_STATIC_ANALYZER": "YES",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SUPPRESS_WARNINGS": "NO",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_COMPILATION_MODE[config=AppStore]": "wholemodule",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=AppStore]": "-O",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_STRICT_MEMORY_SAFETY": "YES",
    "SWIFT_SUPPRESS_WARNINGS": "NO",
    "SWIFT_TREAT_WARNINGS_AS_ERRORS": "YES",
    "SWIFT_VERSION": "5.0",
    "TREAT_MISSING_SCRIPT_PHASE_OUTPUTS_AS_ERRORS": "YES",
    "VALIDATE_PRODUCT": "YES",
    "WARNING_CFLAGS": [
      "$(inherited)",
      "-Weverything",
    ],
    "WATCHOS_DEPLOYMENT_TARGET": "26.0",
  },
  "last-upgrade": "27.0",
}
