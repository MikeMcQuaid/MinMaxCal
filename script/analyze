#!/bin/bash
# Static analysis: unused declarations and imports via SwiftLint's
# analyzer, plus dead-code detection via Periphery.
set -euo pipefail

cd "$(dirname "$0")/.."

flags=(--build-tests --scratch-path .build/analyze -v)
if [[ -n "${SV_SESSION_ID:-}" ]]; then
  export SWIFTPM_DISABLE_SANDBOX=1
  export SWIFT_BUILD_USE_SANDBOX=0
  flags+=(--disable-sandbox --jobs 6)
fi

# The analyzer reads compiler invocations from the log, so every file
# has to be compiled: build from scratch into its own directory. A
# failed build must never be analysed, since a stale log reports a
# confident "0 violations".
log=.build/analyze-build.log
mkdir -p .build
rm -rf .build/analyze
if ! swift build "${flags[@]}" >"${log}" 2>&1; then
  echo "analyze aborted: the build failed, so there is nothing trustworthy to analyse" >&2
  grep -E "error:" "${log}" | head -20 >&2
  exit 1
fi
swiftlint analyze --compiler-log-path "${log}" --strict --quiet

# Periphery's project parser requires .pbxproj, so scan the native
# JSON project's index store through its generic configuration.
index=.build/analyze-index
args=(
  -project MinMaxCal.xcodeproj
  -scheme MinMaxCal
  -configuration Debug
  -destination "${XCODE_DESTINATION:-platform=macOS,arch=arm64}"
  -derivedDataPath "${index}"
  COMPILER_INDEX_STORE_ENABLE=YES
)
if [[ -n "${SV_SESSION_ID:-}" ]]; then
  # The literal $(inherited) is for xcodebuild, not the shell.
  # shellcheck disable=SC2016
  args+=(
    -jobs 6
    -IDEPackageSupportDisableManifestSandbox=1
    -IDEPackageSupportDisablePackageSandbox=1
    'OTHER_SWIFT_FLAGS=$(inherited) -disable-sandbox'
  )
fi
xcodebuild build "${args[@]}" >"${index}.log" 2>&1 || {
  echo "analyze aborted: the index build failed, so periphery has nothing trustworthy to scan" >&2
  grep -E "error:" "${index}.log" | head -20 >&2
  exit 1
}
cat >.build/analyze-project.json <<EOF
{
  "indexstores": ["${index}/Index.noindex/DataStore"],
  "plists": ["App/Info.plist"],
  "test_targets": [],
  "xibs": [],
  "xcdatamodels": [],
  "xcmappingmodels": []
}
EOF
periphery scan --generic-project-config .build/analyze-project.json --strict --disable-update-check
