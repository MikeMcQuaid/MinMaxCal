#!/bin/bash
# Build the app, then replace /Applications/MinMaxCal.app and relaunch
# it, so the login item and the running copy always point at one path.
set -euo pipefail

cd "$(dirname "$0")/.."

app="$(script/build | tee /dev/stderr | tail -1)"
destination=/Applications/MinMaxCal.app

pkill -x -u "${UID}" MinMaxCal || true
SECONDS=0
while pgrep -x -u "${UID}" MinMaxCal &>/dev/null; do
  if ((SECONDS >= 10)); then
    echo 'MinMaxCal did not stop; installation cancelled' >&2
    exit 1
  fi
  sleep 0.1
done
rm -rf "${destination}"
ditto "${app}" "${destination}"
open -n "${destination}"
echo "Installed ${destination}"
