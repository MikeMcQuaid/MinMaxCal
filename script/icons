#!/bin/bash
# Render Leaf.svg and AppMark.svg to PNG previews in .test-scratch/icons,
# approximating the Icon Composer tile for the 512-pixel Dock preview.
set -euo pipefail

cd "$(dirname "$0")/.."

menu_bar_icon=App/Assets.xcassets/MenuBarIcon.imageset/Leaf.svg
app_icon=App/Icons/AppIcon.icon/Assets/AppMark.svg
output=.test-scratch/icons
rm -rf "${output}"
mkdir -p "${output}"

swift - "${menu_bar_icon}" "${app_icon}" "${output}" <<'SWIFT'
import AppKit

let arguments = CommandLine.arguments
let menuBarIcon = NSImage(contentsOf: URL(filePath: arguments[1]))!
let appIcon = NSImage(contentsOf: URL(filePath: arguments[2]))!
let output = URL(filePath: arguments[3])

func write(_ image: NSImage, size: Int, name: String, draw: (NSRect) -> Void) {
    let bitmap = NSBitmapImageRep(
        bitmapDataPlanes: nil, pixelsWide: size, pixelsHigh: size, bitsPerSample: 8,
        samplesPerPixel: 4, hasAlpha: true, isPlanar: false,
        colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0
    )!
    NSGraphicsContext.saveGraphicsState()
    NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: bitmap)
    draw(NSRect(x: 0, y: 0, width: size, height: size))
    NSGraphicsContext.restoreGraphicsState()
    let file = output.appending(path: "\(name)-\(size).png")
    try! bitmap.representation(using: .png, properties: [:])!.write(to: file)
    print(file.path())
}

for size in [18, 36] {
    write(menuBarIcon, size: size, name: "menu-bar") { rect in
        NSColor.white.setFill()
        rect.fill()
        menuBarIcon.draw(in: rect)
    }
}

write(appIcon, size: 512, name: "dock") { rect in
    let tile = NSBezierPath(roundedRect: rect.insetBy(dx: 26, dy: 26), xRadius: 112, yRadius: 112)
    NSGradient(starting: NSColor(red: 0.35, green: 0.6, blue: 0.98, alpha: 1), ending: NSColor(red: 0.12, green: 0.35, blue: 0.85, alpha: 1))!
        .draw(in: tile, angle: -90)
    appIcon.draw(in: rect.insetBy(dx: 72, dy: 72))
}
SWIFT
