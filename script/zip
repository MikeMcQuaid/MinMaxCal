#!/bin/bash
# Zip the built app as .build/MinMaxCal-<version>.zip, with MinMaxCal.app
# as the zip's only top-level entry, and print the zip's path.
set -euo pipefail

cd "$(dirname "$0")/.."

app=.build/DerivedData/Build/Products/Release/MinMaxCal.app
[[ -d "${app}" ]] || {
  echo "Run script/build first: ${app} is missing" >&2
  exit 1
}
codesign --verify --deep --strict "${app}"

version="$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "${app}/Contents/Info.plist" 2>/dev/null || true)"
[[ -n "${version}" ]] || {
  echo "${app} has no CFBundleShortVersionString to name the zip by" >&2
  exit 1
}
zip=".build/MinMaxCal-${version}.zip"
rm -f "${zip}"
ditto -c -k --sequesterRsrc --keepParent "${app}" "${zip}"
echo "${zip}"
